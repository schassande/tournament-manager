rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTournamentManager(tournament) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in tournament.managerEmails;
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/PlaformAdmin/$(request.auth.token.email));
    }

    function canManageTournament(tournamentId) {
      return isPlatformAdmin()
        || isTournamentManager(
          get(/databases/$(database)/documents/tournament/$(tournamentId)).data
        );
    }

    // Allows the initial attendee to be created in the same atomic write as
    // its tournament. getAfter() sees the tournament written by that request.
    function canManageTournamentAfterWrite(tournamentId) {
      return isPlatformAdmin()
        || isTournamentManager(
          getAfter(/databases/$(database)/documents/tournament/$(tournamentId)).data
        )
        || canManageTournament(tournamentId);
    }

    function validUpgradeVote(vote) {
      return vote in ['Yes', 'Not yet', 'Possible', 'DNS', 'Voting'];
    }

    function isRefereeCoachAttendee(attendeeId, tournamentId) {
      return signedIn()
        && get(/databases/$(database)/documents/attendee/$(attendeeId)).data.tournamentId == tournamentId
        && get(/databases/$(database)/documents/attendee/$(attendeeId)).data.isRefereeCoach == true
        && get(/databases/$(database)/documents/person/$(get(/databases/$(database)/documents/attendee/$(attendeeId)).data.personId)).data.email == request.auth.token.email;
    }

    function isEligibleUpgradeReferee(refereeAttendeeId, tournamentId) {
      return get(/databases/$(database)/documents/attendee/$(refereeAttendeeId)).data.tournamentId == tournamentId
        && get(/databases/$(database)/documents/attendee/$(refereeAttendeeId)).data.isReferee == true
        && get(/databases/$(database)/documents/attendee/$(refereeAttendeeId)).data.referee.upgrade.badge != 0;
    }

    function validCoachUpgradeVote() {
      return request.resource.data.tournamentId is string
        && request.resource.data.refereeAttendeeId is string
        && request.resource.data.coachAttendeeId is string
        && request.resource.data.vote is string
        && validUpgradeVote(request.resource.data.vote)
        && request.resource.data.comments is list
        && isRefereeCoachAttendee(request.resource.data.coachAttendeeId, request.resource.data.tournamentId)
        && isEligibleUpgradeReferee(request.resource.data.refereeAttendeeId, request.resource.data.tournamentId);
    }

    function validPanelUpgradeVote() {
      return request.resource.data.tournamentId is string
        && request.resource.data.refereeAttendeeId is string
        && request.resource.data.vote is string
        && validUpgradeVote(request.resource.data.vote)
        && request.resource.data.updatedByCoachAttendeeId is string
        && request.resource.data.needToSee is list
        && (request.resource.data.needToTalk == null || request.resource.data.needToTalk is string)
        && isRefereeCoachAttendee(request.resource.data.updatedByCoachAttendeeId, request.resource.data.tournamentId)
        && isEligibleUpgradeReferee(request.resource.data.refereeAttendeeId, request.resource.data.tournamentId);
    }

    // Ranking identity follows the current nested Attendee.person contract.
    function isRankingCoach(attendeeId, tournamentId) {
      let attendee = get(/databases/$(database)/documents/attendee/$(attendeeId)).data;
      return signedIn()
        && request.auth.token.email != null
        && attendee.tournamentId == tournamentId
        && attendee.isRefereeCoach == true
        && attendee.person.personId is string
        && get(/databases/$(database)/documents/person/$(attendee.person.personId)).data.email == request.auth.token.email;
    }

    function rankingEnabled(tournamentId) {
      return 'RANKING' in get(/databases/$(database)/documents/tournament/$(tournamentId)).data.enablesModules;
    }

    // Stage 1 only creates empty configurations. Tab writes are added with their validated stages.
    function validNewRefereeRanking(documentId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['id', 'lastChange', 'name', 'tournamentId',
          'selectedRefereeAttendeeIds', 'selectedCoachAttendeeIds', 'nbRefereesToRank',
          'voteMajority', 'status', 'panelRefereesRanking', 'panelResultState', 'updatedByCoachAttendeeId'])
        && data.id == documentId
        && data.lastChange is number
        && data.name is string && data.name.matches('.*[^\\s].*')
        && data.tournamentId is string && data.updatedByCoachAttendeeId is string
        && isRankingCoach(data.updatedByCoachAttendeeId, data.tournamentId)
        && rankingEnabled(data.tournamentId)
        && data.status == 'CONFIGURE'
        && data.selectedRefereeAttendeeIds == [] && data.selectedCoachAttendeeIds == []
        && data.nbRefereesToRank == 15 && data.voteMajority == 1
        && data.panelResultState == 'NOT_COMPUTED'
        && data.panelRefereesRanking == { 'rankingLastChange': '', 'rankedRefereeAttendeeIds': [], 'stats': [] };
    }

    function validRankingStatusChange() {
      let old = resource.data;
      let next = request.resource.data;
      return next.diff(old).affectedKeys().hasOnly(['status', 'updatedByCoachAttendeeId', 'lastChange'])
        && next.lastChange is number
        && isRankingCoach(next.updatedByCoachAttendeeId, old.tournamentId)
        && rankingEnabled(old.tournamentId)
        && ((old.status == 'CONFIGURE' && next.status == 'INDIVIDUAL_RANKING')
          || (old.status == 'INDIVIDUAL_RANKING' && next.status == 'PANEL_RANKING')
          || (old.status == 'PANEL_RANKING' && next.status == 'INDIVIDUAL_RANKING')
          || (old.status == 'PANEL_RANKING' && next.status == 'CLOSED'
            && old.panelResultState == 'CURRENT'
            && old.panelRefereesRanking.rankingLastChange is string
            && old.panelRefereesRanking.rankingLastChange.size() > 0));
    }

    function validRankingRefereeChange() {
      let old = resource.data;
      let next = request.resource.data;
      let selectionChanged = next.selectedRefereeAttendeeIds != old.selectedRefereeAttendeeIds;
      return old.status != 'CLOSED'
        && next.diff(old).affectedKeys().hasOnly(['name', 'nbRefereesToRank', 'selectedRefereeAttendeeIds',
          'panelResultState', 'updatedByCoachAttendeeId', 'lastChange'])
        && next.lastChange is number
        && isRankingCoach(next.updatedByCoachAttendeeId, old.tournamentId) && rankingEnabled(old.tournamentId)
        && next.name is string && next.name.matches('.*[^\\s].*')
        && next.nbRefereesToRank is int && next.nbRefereesToRank > 0 && next.nbRefereesToRank <= 9007199254740991
        && next.selectedRefereeAttendeeIds is list
        && next.selectedRefereeAttendeeIds.toSet().size() == next.selectedRefereeAttendeeIds.size()
        // Shrinking requires the Admin transaction so other owners' records are cleaned atomically.
        && next.selectedRefereeAttendeeIds.hasAll(old.selectedRefereeAttendeeIds)
        && ((!selectionChanged && next.panelResultState == old.panelResultState)
          || (selectionChanged && next.panelResultState == (old.panelResultState == 'NOT_COMPUTED' ? 'NOT_COMPUTED' : 'STALE')));
    }

    // Configuration remains available to every tournament coach, independently of panel membership.
    function validRankingCoachChange() {
      let old = resource.data;
      let next = request.resource.data;
      let changed = next.selectedCoachAttendeeIds.toSet() != old.selectedCoachAttendeeIds.toSet()
        || next.voteMajority != old.voteMajority;
      return old.status in ['CONFIGURE', 'INDIVIDUAL_RANKING', 'PANEL_RANKING']
        && next.diff(old).affectedKeys().hasOnly(['selectedCoachAttendeeIds', 'voteMajority',
          'panelResultState', 'updatedByCoachAttendeeId', 'lastChange'])
        && next.lastChange is number
        && isRankingCoach(next.updatedByCoachAttendeeId, old.tournamentId) && rankingEnabled(old.tournamentId)
        && next.selectedCoachAttendeeIds is list
        && next.selectedCoachAttendeeIds.toSet().size() == next.selectedCoachAttendeeIds.size()
        && next.voteMajority is int && next.voteMajority > 0 && next.voteMajority <= 9007199254740991
        && next.panelResultState == (changed && old.panelResultState != 'NOT_COMPUTED' ? 'STALE' : old.panelResultState);
    }

    // Matches the shared helper, preserving Unicode and escaping percent before delimiters.
    function rankingIdComponent(value) {
      return value.replace('%', '%25').replace('/', '%2F').replace('[|]', '%7C');
    }

    function rankingVoteId(parentId, coachId) {
      return rankingIdComponent(parentId) + '|' + rankingIdComponent(coachId);
    }

    function individualVoteChanged(old, next) {
      return old == null
        ? next.locked
        : old.locked != next.locked || ((old.locked || next.locked) && old.rankedRefereeAttendeeIds != next.rankedRefereeAttendeeIds);
    }

    // Targets need a tournament coach attendee, but no account or linked person.
    function canEditRankingTarget(next, parent) {
      let target = get(/databases/$(database)/documents/attendee/$(next.coachAttendeeId)).data;
      return next.updatedByCoachAttendeeId is string
        && isRankingCoach(next.updatedByCoachAttendeeId, parent.tournamentId)
        && target.tournamentId == parent.tournamentId && target.isRefereeCoach == true
        && (next.updatedByCoachAttendeeId == next.coachAttendeeId
          || (next.updatedByCoachAttendeeId in parent.selectedCoachAttendeeIds
            && next.coachAttendeeId in parent.selectedCoachAttendeeIds));
    }

    function validIndividualRecord(documentId, next, old, parent) {
      return next.keys().hasOnly(['id', 'lastChange', 'tournamentId', 'tournamentRefereeRankingId',
          'coachAttendeeId', 'updatedByCoachAttendeeId', 'locked', 'rankingLastChange', 'rankedRefereeAttendeeIds'])
        && next.id == documentId
        && documentId == rankingVoteId(next.tournamentRefereeRankingId, next.coachAttendeeId)
        && next.tournamentId == parent.tournamentId
        && next.tournamentRefereeRankingId == parent.id
        && parent.status in ['INDIVIDUAL_RANKING', 'PANEL_RANKING']
        && canEditRankingTarget(next, parent) && rankingEnabled(parent.tournamentId)
        && next.lastChange is number && next.locked is bool
        && next.rankingLastChange is string && next.rankingLastChange.size() > 0
        && next.rankedRefereeAttendeeIds is list
        && next.rankedRefereeAttendeeIds.toSet().size() == next.rankedRefereeAttendeeIds.size()
        && next.rankedRefereeAttendeeIds.hasOnly(parent.selectedRefereeAttendeeIds)
        && (old == null || (next.tournamentId == old.tournamentId
          && next.tournamentRefereeRankingId == old.tournamentRefereeRankingId && next.coachAttendeeId == old.coachAttendeeId
          && (!old.locked || next.rankedRefereeAttendeeIds == old.rankedRefereeAttendeeIds)
          && (next.rankedRefereeAttendeeIds != old.rankedRefereeAttendeeIds || next.rankingLastChange == old.rankingLastChange)));
    }

    function validIndividualWrite(documentId, old) {
      let next = request.resource.data;
      let parentPath = /databases/$(database)/documents/tournament-referee-ranking/$(next.tournamentRefereeRankingId);
      let parent = get(parentPath).data;
      let relevant = next.coachAttendeeId in parent.selectedCoachAttendeeIds && individualVoteChanged(old, next);
      return validIndividualRecord(documentId, next, old, parent)
        && (!relevant || parent.panelResultState == 'NOT_COMPUTED' || getAfter(parentPath).data.panelResultState == 'STALE');
    }

    // Link a contributing target vote to its actual editor, without replacing parent configuration or output.
    function validIndividualFreshnessChange() {
      let old = resource.data;
      let next = request.resource.data;
      let id = rankingVoteId(old.id, next.updatedCoachAttendeeId);
      let path = /databases/$(database)/documents/coach-referees-ranking/$(id);
      let before = exists(path) ? get(path).data : null;
      let after = getAfter(path).data;
      return next.diff(old).affectedKeys().hasOnly(['panelResultState', 'updatedByCoachAttendeeId',
          'updatedCoachAttendeeId', 'lastChange'])
        && old.panelResultState != 'NOT_COMPUTED' && next.panelResultState == 'STALE' && next.lastChange is number
        && next.updatedCoachAttendeeId in old.selectedCoachAttendeeIds
        && after.updatedByCoachAttendeeId == next.updatedByCoachAttendeeId
        && after.lastChange == next.lastChange
        && validIndividualRecord(id, after, before, old)
        && individualVoteChanged(before, after);
    }

    match /tournament-referee-ranking/{documentId} {
      // Deliberately temporary: every authenticated user can read both ranking collections.
      allow read: if signedIn();
      allow create: if signedIn() && validNewRefereeRanking(documentId);
      allow update: if signedIn() && (validRankingStatusChange() || validRankingRefereeChange() || validRankingCoachChange() || validIndividualFreshnessChange());
      // Supports complete tournament deletion, including after attendees have been removed.
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /coach-referees-ranking/{documentId} {
      allow read: if signedIn();
      allow create: if signedIn() && validIndividualWrite(documentId, null);
      allow update: if signedIn() && validIndividualWrite(documentId, resource.data);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /region/{documentId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /person/{documentId} {
      allow read, create, update, delete: if signedIn();
    }

    match /tournament/{documentId} {
      allow read: if true;
      allow create: if isTournamentManager(request.resource.data);
      allow update, delete: if isTournamentManager(resource.data) || isPlatformAdmin();
    }

    match /fit-data/{documentId} {
      allow read: if canManageTournament(resource.data.tournamentId);
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /attendee/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournamentAfterWrite(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /game/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /game-attendee-allocation/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /tournament-referee-allocation/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /fragment-referee-allocation/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /tournament-referee-allocation-statistics/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /fragment-referee-allocation-statistics/{documentId} {
      allow read: if signedIn();
      allow create: if canManageTournament(request.resource.data.tournamentId);
      allow update: if request.resource.data.tournamentId == resource.data.tournamentId
        && canManageTournament(resource.data.tournamentId);
      allow delete: if canManageTournament(resource.data.tournamentId);
    }

    match /referee-upgrade-coach-vote/{documentId} {
      allow read: if signedIn();
      allow create: if validCoachUpgradeVote();
      allow update: if validCoachUpgradeVote()
        && request.resource.data.tournamentId == resource.data.tournamentId
        && request.resource.data.refereeAttendeeId == resource.data.refereeAttendeeId
        && request.resource.data.coachAttendeeId == resource.data.coachAttendeeId;
      allow delete: if false;
    }

    match /referee-upgrade-panel-vote/{documentId} {
      allow read: if signedIn();
      allow create: if validPanelUpgradeVote();
      allow update: if validPanelUpgradeVote()
        && request.resource.data.tournamentId == resource.data.tournamentId
        && request.resource.data.refereeAttendeeId == resource.data.refereeAttendeeId;
      allow delete: if false;
    }

    match /email_personid/{documentId} {
      allow read, write: if false;
    }

    // Platform administrators are managed outside the client application.
    match /PlaformAdmin/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
